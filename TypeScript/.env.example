# --- Photon / Neutron ---
SHARED_SECRET=
# M2M app credentials (app.photon.health settings). Backend mints + rotates the
# provider token from these; CLIENT_ID/CLIENT_SECRET also accepted.
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=
# Optional: only for scripts/dev_tunnel.py webhook admin. Needed because the M2M
# app token lacks webhook permission. Paste a fresh user token, OR grant the M2M
# app webhook scopes in Photon and leave this blank.
PHOTON_TOKEN=
# Defaults are correct for the Neutron sandbox:
PHOTON_AUTH_URL=https://auth.neutron.health/oauth/token
PHOTON_AUDIENCE=https://api.neutron.health
CLINICAL_API_URL=https://clinical-api.neutron.health/graphql
PATIENT_API_URL=https://patient-api.neutron.health/graphql
PROVIDER_API_URL=https://api.neutron.health/graphql

# --- Geocoding fallback point for the nearby-pharmacies query ---
# We geocode the patient's street address first; these are only used if that
# fails or the address is missing. (TODO: remove once geocoding is trusted.)
GEO_LAT=
GEO_LNG=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- SIP / Twilio (reuse the Rock-scheduler outbound trunk + number) ---
SIP_OUTBOUND_TRUNK_ID=
TWILIO_CALLER_NUMBER=

# Optional: send the "You're set at ..." confirmation SMS. Blank = log only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Agent worker ---
AGENT_NAME=photon-greeter
AGENT_DISPLAY_NAME=Hannah
ORG_NAME=your pharmacy
SUPPORT_SMS_NUMBER=513-866-3212
# Inbound: seconds to wait before an authenticated caller gets their callback (>=300)
CALLBACK_DELAY_S=300
# Inbound agent POSTs callbacks here; blank defaults to http://localhost:${PORT}/internal/callback
DISPATCH_CALLBACK_URL=
# 1 = write tools skip real Photon changes (use for console testing)
DRY_RUN=0
# Console mode only: which context/<orderId>.json to load
CONSOLE_ORDER_ID=

# --- Test redirect: set to YOUR phone (E.164) to redirect calls + SMS ---
TEST_PHONE_OVERRIDE=

# --- Webhook server ---
PORT=3000

# --- Engine (keys optional; blank routes via LiveKit Inference) ---
LLM_MODEL=gpt-4.1-mini
# Emotion/sigh/soft-tone tags
EXPRESSIVE=1
# LiveKit Inference TTS (no vendor key). Voice = Fish voice-library id (Adrian)
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=9a9cf47702da476aa4629e2506d4a857
TTS_SPEED=1.0
EOT_MIN_DELAY=0.4
EOT_MAX_DELAY=1.6
EOT_THRESHOLD=0.25
USER_AWAY_S=6
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
